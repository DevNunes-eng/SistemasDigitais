# =========================================================================
# HANGMAN GAME - SPARTAN-3A / SPARTAN-3AN
# Pin assignment constraints
# Target project: XC3S400AN-FGG400-5
# =========================================================================


# =========================================================================
# SYSTEM CLOCK - 50 MHz
# =========================================================================

NET "clk" LOC = "E12" | IOSTANDARD = LVCMOS33;

NET "clk" TNM_NET = "clk";
TIMESPEC "TS_CLK" = PERIOD "clk" 20 ns HIGH 50%;


# =========================================================================
# PUSH BUTTONS
# =========================================================================

# BTN_EAST - Reset
NET "rst" LOC = "T16" | IOSTANDARD = LVCMOS33 | PULLDOWN;

# BTN_WEST - Enter / Start Game
NET "btn_in" LOC = "U15" | IOSTANDARD = LVCMOS33 | PULLDOWN;


# =========================================================================
# SLIDE SWITCHES
# =========================================================================

# Word selection switches

NET "switches<3>" LOC = "T9"  | IOSTANDARD = LVCMOS33;
NET "switches<2>" LOC = "U8"  | IOSTANDARD = LVCMOS33;
NET "switches<1>" LOC = "U10" | IOSTANDARD = LVCMOS33;
NET "switches<0>" LOC = "V8"  | IOSTANDARD = LVCMOS33;


# =========================================================================
# LED OUTPUTS
# =========================================================================

NET "led<7>" LOC = "W21" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
NET "led<6>" LOC = "Y22" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
NET "led<5>" LOC = "V20" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
NET "led<4>" LOC = "V19" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
NET "led<3>" LOC = "U19" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
NET "led<2>" LOC = "U20" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
NET "led<1>" LOC = "T19" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
NET "led<0>" LOC = "R20" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;


# =========================================================================
# PS/2 KEYBOARD
# Both lines are open-collector
# =========================================================================

NET "ps2_clk"  LOC = "W12" | IOSTANDARD = LVCMOS33 | PULLUP;
NET "ps2_data" LOC = "V11" | IOSTANDARD = LVCMOS33 | PULLUP;


# =========================================================================
# LCD DISPLAY - 4-BIT MODE
# =========================================================================

# Control signals

NET "lcd_e"  LOC = "AB4" | IOSTANDARD = LVCMOS33;
NET "lcd_rs" LOC = "Y14" | IOSTANDARD = LVCMOS33;
NET "lcd_rw" LOC = "W13" | IOSTANDARD = LVCMOS33;

# Data bus - upper nibble only (DB7..DB4)

NET "lcd_db<7>" LOC = "Y15"  | IOSTANDARD = LVCMOS33;
NET "lcd_db<6>" LOC = "AB16" | IOSTANDARD = LVCMOS33;
NET "lcd_db<5>" LOC = "Y16"  | IOSTANDARD = LVCMOS33;
NET "lcd_db<4>" LOC = "AA12" | IOSTANDARD = LVCMOS33;


# =========================================================================
# TIMING CONSTRAINTS
# =========================================================================

# PS/2 signals are asynchronous to the FPGA clock.
# Synchronize them internally in the VHDL design.

NET "ps2_clk" TIG;
NET "ps2_data" TIG;


# =========================================================================
# END OF CONSTRAINTS
# =========================================================================